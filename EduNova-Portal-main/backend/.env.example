# EduNova Backend Environment Variables

# Server
PORT=5000
NODE_ENV="development"

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/edunova_db?schema=public"

# JWT Authentication
JWT_SECRET="your_jwt_secret_key_here"
JWT_REFRESH_SECRET="your_refresh_secret_key_here"
JWT_EXPIRES_IN=7d

# Gemini AI
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLIENT_ID="your_google_oauth_web_client_id"

# Password reset email (Gmail: use an App Password, not your normal password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your_gmail_address@gmail.com"
SMTP_PASS="your_16_character_gmail_app_password"
MAIL_FROM="EduNova <your_gmail_address@gmail.com>"

# CORS
FRONTEND_URL="http://localhost:3000"
